# GEMINI_API_KEY: Required for Gemini AI API calls (kept strictly server-side).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Optional comma-separated list of additional trusted origins for /api/* proxy requests.
ALLOWED_ORIGINS=""

# Server-side rate limiting defaults (15-minute window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_GENERAL_MAX=150
RATE_LIMIT_AI_MAX=25
RATE_LIMIT_UPLOAD_MAX=30
RATE_LIMIT_CHUNK_MAX=800
